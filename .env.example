# Proofly — development environment.
# Copy to .env and adjust. .env is gitignored and must never be committed (NFR-10).
#
#   cp .env.example .env

# ---------------------------------------------------------------- runtime ---
NODE_ENV=development
# Port the NestJS API listens on. The Vite dev server proxies /api here.
PORT=3000

# --------------------------------------------------------------- database ---
# Host port 5434 matches docker-compose.yml (5432/5433 are often already taken).
DATABASE_URL=postgresql://proofly:proofly@localhost:5434/proofly?schema=public

# ------------------------------------------------------------------- auth ---
# REQUIRED. Boot fails if this is missing or shorter than 32 characters, so a
# weak secret can never reach a running server (devops-use-config-module).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-text
# How long a session cookie stays valid. ms-style string: 15m, 12h, 7d.
JWT_EXPIRES_IN=7d
# bcrypt work factor. Minimum 10 is enforced at boot (requirements §11).
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------- http ---
# The single browser origin allowed to send credentialed requests (CORS).
WEB_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------ dates ---
# "Today" is resolved in this zone for every deadline calculation (BR-05, D-10).
APP_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------- uploads ---
# Receipts are written here. Must stay OUTSIDE any static/public route so a
# stored key is never guessable over HTTP (BR-10, NFR-11).
UPLOAD_DIR=./var/uploads

# ------------------------------------------------------------------- mail ---
# Defaults point at the Mailpit container in docker-compose: it accepts SMTP on
# 1025 and shows every message at http://localhost:8025. Nothing is relayed
# onward, so a bug cannot email a real person.
#
# For real delivery, point these at any SMTP provider — no code changes:
#   Brevo      smtp-relay.brevo.com:587      (300/day free)
#   Resend     smtp.resend.com:587           (100/day free, domain verified)
#   SendGrid   smtp.sendgrid.net:587         (100/day free)
#   Gmail      smtp.gmail.com:587            (app password, needs 2FA)
SMTP_HOST=localhost
SMTP_PORT=1025
# Leave both empty for Mailpit; a real provider needs them.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Purchase Tracker <no-reply@purchasetracker.local>

# The base for links in emails. Deliberately config, never the Host header: a
# reset link built from a request header can be rewritten by whoever sends it.
APP_URL=http://localhost:5173

# ---------------------------------------------------------- rate limiting ---
# Attempts allowed at /auth/* per address, and over how many seconds. Five a
# minute is generous for a person and useless for a script. It matters most
# for forgot-password, which sends mail to an address the caller chooses.
THROTTLE_AUTH_LIMIT=5
THROTTLE_AUTH_TTL=60

# ------------------------------------------------------------------- tls ----
# true for a managed Postgres, false for the one in docker-compose.
DATABASE_SSL=false
