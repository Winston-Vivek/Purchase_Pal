# Proofly — development environment.
# Copy to .env and adjust. .env is gitignored and must never be committed (NFR-10).
#
#   cp .env.example .env

# ---------------------------------------------------------------- runtime ---
NODE_ENV=development
# Port the NestJS API listens on. The Vite dev server proxies /api here.
PORT=3000

# --------------------------------------------------------------- database ---
# Host port 5434 matches docker-compose.yml (5432/5433 are often already taken).
DATABASE_URL=postgresql://proofly:proofly@localhost:5434/proofly?schema=public

# ------------------------------------------------------------------- auth ---
# REQUIRED. Boot fails if this is missing or shorter than 32 characters, so a
# weak secret can never reach a running server (devops-use-config-module).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-text
# How long a session cookie stays valid. ms-style string: 15m, 12h, 7d.
JWT_EXPIRES_IN=7d
# bcrypt work factor. Minimum 10 is enforced at boot (requirements §11).
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------- http ---
# The single browser origin allowed to send credentialed requests (CORS).
WEB_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------ dates ---
# "Today" is resolved in this zone for every deadline calculation (BR-05, D-10).
APP_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------- uploads ---
# Receipts are written here. Must stay OUTSIDE any static/public route so a
# stored key is never guessable over HTTP (BR-10, NFR-11).
UPLOAD_DIR=./var/uploads
