# Proofly — environment for the API e2e suite (docs/test-plan.md §5).
# Copy to .env.test. Loaded by apps/api/test/setup-env.ts before Nest boots.
#
#   cp .env.test.example .env.test
#
# The ONLY meaningful difference from .env is the database: the e2e suite
# truncates every table between tests, so it must never point at dev data.

NODE_ENV=test
PORT=3001

# Separate database, created by docker/postgres/init-test-db.sh.
DATABASE_URL=postgresql://proofly:proofly@localhost:5434/proofly_test?schema=public

JWT_SECRET=test-only-secret-not-used-anywhere-else-0123456789
JWT_EXPIRES_IN=7d
# Lowest value the config allows. Keeps ~100 e2e tests from burning minutes on
# password hashing while still satisfying the "cost >= 10" rule.
BCRYPT_ROUNDS=10

WEB_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

# Wiped between runs; never the real upload directory.
UPLOAD_DIR=./var/uploads-test

# The suite signs in hundreds of times from one address; a realistic ceiling
# would refuse tests for behaving like tests. throttling.e2e-spec.ts overrides
# this to a low value for the four cases that prove the limit works.
THROTTLE_AUTH_LIMIT=100000
THROTTLE_AUTH_TTL=60
