{
  "name": "proofly",
  "version": "0.1.0",
  "private": true,
  "description": "Proofly — purchase, receipt and warranty manager. Repo root: phase gates and shared scripts.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:down": "docker compose down",
    "db:up": "docker compose up -d --wait",
    "gate": "node gates/run-gate.mjs",
    "gate:status": "node gates/run-gate.mjs --status",
    "lint": "npm --prefix apps/api run lint",
    "lint:web": "npm --prefix apps/web run lint",
    "mockups": "node design/render-mockups.mjs",
    "test": "npm --prefix apps/api test",
    "test:e2e": "npm --prefix apps/api run test:e2e",
    "test:web": "npm --prefix apps/web test",
    "tokens:check": "node design/check-tokens.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "gate:test": "node --test gates/checks.test.mjs",
    "testcases:sync": "node gates/sync-test-cases.mjs",
    "testcases:check": "node gates/sync-test-cases.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
