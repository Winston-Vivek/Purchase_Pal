          "paths": [
            "design/ui-guide.md",
            "design/wireframes.html"
          ]
        },
        {
          "kind": "command",
          "label": "ui-guide carries the @theme token block the frontend must copy",
          "cwd": ".",
          "run": "grep -q '@theme' design/ui-guide.md"
        }
      ]
    },
