          "kind": "command",
          "label": "Build clean",
          "cwd": "apps/api",
          "run": "npm run build"
        },
        {
          "kind": "test-ids",
          "label": "Every Day 3 test case passes",
          "suites": [
            "unit",
            "e2e"
          ],
          "ids": [
            "UT-DATE-01..24",
            "API-ERR-01..05",
            "API-AUTH-01..11",
            "API-SET-01..06",
            "API-PUR-01..30"
          ]
        },
        {
          "kind": "coverage",
          "label": "DatesService coverage >= 90%",
          "pattern": "common/dates",
          "minLines": 90,
          "minBranches": 90
        },
        {
          "kind": "tdd-history",
          "label": "Red-then-green visible in git log",
          "areas": [
            "dates",
            "errors",
            "auth",
            "settings",
            "purchases"
