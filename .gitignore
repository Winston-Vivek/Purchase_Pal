# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment — never commit real secrets (NFR-10)
.env
.env.*
!.env.example
!.env.test.example

# Uploaded receipts: private storage, never in git (BR-10, NFR-11).
#
# Anchored to var/ deliberately. A bare `storage/` here matched
# apps/api/src/common/storage/ and kept the whole storage module out of the
# repository — a fresh clone could not build the API, and nothing noticed
# because the files existed locally. UPLOAD_DIR is ./var/uploads.
var/

# Test and coverage output
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Local Claude Code state (the committed skill is tracked explicitly below)
.claude/settings.local.json
